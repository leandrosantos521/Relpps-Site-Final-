BLING_CLIENT_ID=SEU_CLIENT_ID
BLING_CLIENT_SECRET=SEU_CLIENT_SECRET
BLING_REFRESH_TOKEN=SEU_REFRESH_TOKEN
BLING_REDIRECT_URI=http://127.0.0.1:5500/bling-callback.html
PORT=5500
HOST=127.0.0.1

# === CHECKOUT / FRETE ===
# true = nenhuma cobrança real; use para testar o fluxo completo.
CHECKOUT_TEST_MODE=false

# CEP de origem da loja para o Melhor Envio (somente números).
STORE_POSTAL_CODE=

# Melhor Envio: mantenha vazio até a etapa de produção.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_USER_AGENT=Relpps Cosméticos (contato@relpps.com.br)

# Uber Direct: habilitar somente após aprovação/credenciais reais.
UBER_DIRECT_ENABLED=false
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_STORE_ID=

# === PEDIDOS ONLINE / PAGAMENTO ===
# URL pública da loja. Não use 127.0.0.1 em produção.
PUBLIC_SITE_URL=https://relpps.com.br

# InfinitePay Checkout - SOMENTE no backend/Netlify, nunca no config.js.
# Use sua InfiniteTag sem o símbolo $.
INFINITEPAY_HANDLE=

# Supabase - a service_role key fica SOMENTE nas variáveis do Netlify.
SUPABASE_SERVICE_ROLE_KEY=

BLING_CREATE_ORDERS=true
# Produção: pedidos são validados no Bling antes de cobrar.
BLING_SITUACAO_AGUARDANDO_PAGAMENTO_ID=
BLING_SITUACAO_PAGO_ID=
BLING_FORMA_PAGAMENTO_PIX_ID=
BLING_FORMA_PAGAMENTO_CARTAO_ID=
BLING_FORMA_PAGAMENTO_DINHEIRO_ID=

# Endereço mostrado para retirada presencial.
STORE_PICKUP_ADDRESS=C 12, Área Especial 02, Loja 30 - Taguatinga Centro, Brasília - DF - CEP 72010-901
